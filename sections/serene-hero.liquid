<div
  class="serene-hero-banner"
  style="background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');"
>
  <div class="serene-hero-overlay"></div>
  <div class="serene-hero-content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subtext }}</p>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="serene-hero-btn">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Serene Luxury Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Hero Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quiet Luxury, Elevated."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Experience a sanctuary of rejuvenation. Tailored services designed to restore balance and enhance your natural radiance."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Discover Our Services"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Serene Luxury Hero"
    }
  ]
}
{% endschema %}
